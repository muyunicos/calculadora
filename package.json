{
  "name": "calcustickers",
  "version": "0.1.0",
  "private": true,
  "description": "Calculadora de stickers (React + TSX) para el tema GeneratePress child de Muy Únicos.",
  "scripts": {
    "build:js": "esbuild src/index.tsx --bundle --minify --format=iife --target=es2018 --outfile=assets/js/calculadora_stickers.js --loader:.tsx=tsx",
    "watch:js": "esbuild src/index.tsx --bundle --format=iife --target=es2018 --outfile=assets/js/calculadora_stickers.js --loader:.tsx=tsx --watch",
    "build:css": "tailwindcss -i src/styles.css -o assets/css/calculadora_stickers.css --minify",
    "watch:css": "tailwindcss -i src/styles.css -o assets/css/calculadora_stickers.css --watch",
    "build": "npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "calcustickers": "file:",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
